# SALEC production — nusxa: cp env.production.example .env.production
# .env.production ni gitga qo‘ymang.

# --- Postgres / Redis (majburiy) ---
POSTGRES_PASSWORD=change-me-long-random
REDIS_PASSWORD=change-me-long-random

# --- JWT (Railway dagi bilan BIR XIL bo‘lsa login sessiyasi uzilmaydi) ---
# openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- URL / CORS ---
# Veb panel domeni (https, oxirida / yo‘q)
PUBLIC_APP_URL=https://salesarena.sale
# Brauzer API: Coolify + CSP `connect-src 'self'` uchun BO‘SH qoldiring —
# Next.js `/auth` va `/api` ni backendga proxy qiladi.
# To‘g‘ridan-to‘g‘ri api subdomen faqat mobil/integratsiya uchun kerak bo‘lsa to‘ldiring.
PUBLIC_API_URL=
CORS_ALLOWED_ORIGINS=https://salesarena.sale,https://www.salesarena.sale

# Health /ready himoyasi (≥16 belgi)
INTERNAL_HEALTH_TOKEN=change-me-min-16-chars

# --- Cloudflare R2 (tavsiya — fotolar Postgresda bo‘lmasin) ---
# STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# STORAGE_BUCKET=salec-uploads
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_PUBLIC_BASE_URL=https://cdn.example.com

PHOTO_CONTENT_RETENTION_DAYS=60
# Eski slug → yangi (Railway ilovalari / JWT): test1 → aksit
TENANT_SLUG_ALIASES=test1:aksit

# Telegram mijoz boti (compose `telegram-bot` servisi; backend bilan bir xil secret)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_API_SECRET=
BOT_TENANT_SLUG=aksit
