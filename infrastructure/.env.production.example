# SALEC production secrets — `cp .env.production.example .env.production`
# Bu faylni git ga qo‘ymang. Generatsiya: openssl rand -hex 32

POSTGRES_PASSWORD=
REDIS_PASSWORD=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Veb panel origin(lar), vergul bilan. Masalan: https://app.sizning-domen.uz
CORS_ALLOWED_ORIGINS=

# Coolify/proxy orqali brauzer API ni to‘g‘ridan-to‘g‘ri chaqirsa:
# PUBLIC_API_URL=https://api.sizning-domen.uz
PUBLIC_API_URL=

INTERNAL_HEALTH_TOKEN=

# Cloudflare R2 (foto + APK). Bo‘sh qoldirilsa rasmlar siqilgan holda DB da.
# STORAGE_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# STORAGE_BUCKET=salec-uploads
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_PUBLIC_BASE_URL=https://cdn.sizning-domen.uz

PHOTO_CONTENT_RETENTION_DAYS=60
