# Telegram bot — yangi klient yig‘ish (SALEC dan mustaqil jarayon)
# Nusxa: copy .env.example .env

TELEGRAM_BOT_TOKEN=
# SALEC PostgreSQL — spravochnik, hudud, klientlar
# Lokal: postgresql://postgres:YOUR_PASSWORD@localhost:15432/savdo_db
# Deploy: Railway Postgres servisidagi DATABASE_PUBLIC_URL
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:15432/savdo_db
BOT_TENANT_SLUG=test1
MIN_CLIENTS_FOR_EXCEL=5

# Hodim tanish / unikal Telegram ID — deploydagi backend API
SALEC_API_URL=https://backend-production-3cf2.up.railway.app
# Backend dagi TELEGRAM_BOT_API_SECRET bilan bir xil (kamida 16 belgi)
TELEGRAM_BOT_API_SECRET=change-me-min-16-chars

# Railway (24/7): servis telegram-bot
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# SALEC_API_URL=https://backend-production-3cf2.up.railway.app
# TELEGRAM_BOT_API_SECRET=${{backend.TELEGRAM_BOT_API_SECRET}}
# Lokal `npm run dev` ni o‘chiring — Telegram bir vaqtda faqat bitta polling qabul qiladi.
